{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JoCoding-Inc/roblox-skills/design/schema/zones.schema.json",
  "title": "Layout standard: reserved zones, zone map, insets, scale, floors, HUD zones, UI budgets",
  "type": "object",
  "required": [
    "type",
    "schema_version",
    "title",
    "scope",
    "sources",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "zones"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "title": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data": {
      "type": "object",
      "required": [
        "devices",
        "reserved",
        "zone_map",
        "insets",
        "scale",
        "floors",
        "console",
        "hud",
        "budgets"
      ],
      "properties": {
        "floors": {
          "type": "object",
          "required": [
            "tap_target_px",
            "tap_gap_px",
            "frequent_button_px",
            "body_text_px",
            "label_text_px",
            "min_text_size"
          ],
          "properties": {
            "tap_target_px": {
              "$ref": "#/$defs/num"
            },
            "tap_gap_px": {
              "$ref": "#/$defs/num"
            },
            "frequent_button_px": {
              "$ref": "#/$defs/numOrRange"
            },
            "body_text_px": {
              "$ref": "#/$defs/num"
            },
            "label_text_px": {
              "$ref": "#/$defs/num"
            },
            "min_text_size": {
              "$ref": "#/$defs/num"
            },
            "phone_hud_button_max_px": {
              "$ref": "#/$defs/num"
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/leaf"
          }
        },
        "devices": {
          "$ref": "#/$defs/node"
        },
        "reserved": {
          "$ref": "#/$defs/node"
        },
        "zone_map": {
          "$ref": "#/$defs/node"
        },
        "insets": {
          "$ref": "#/$defs/node"
        },
        "scale": {
          "$ref": "#/$defs/node"
        },
        "console": {
          "$ref": "#/$defs/node"
        },
        "hud": {
          "$ref": "#/$defs/node"
        },
        "budgets": {
          "$ref": "#/$defs/node"
        }
      },
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/$defs/leaf"
          },
          {
            "$ref": "#/$defs/node"
          }
        ]
      }
    }
  },
  "$defs": {
    "provenance": {
      "enum": [
        "measured",
        "documented",
        "field",
        "opinion"
      ],
      "description": "measured: we measured it (engine source, pixels on reference frames, store API, tested in Studio); documented: Roblox docs or staff posts; field: observed while shipping a game (dated when known); opinion: judgment, house style, owner rule or community starting value"
    },
    "leaf": {
      "type": "object",
      "required": [
        "v",
        "p"
      ],
      "additionalProperties": false,
      "properties": {
        "v": {
          "description": "the value; units are in the key name (_px, _s, _share, _scale, _rgb, _studs, _deg); [a, b] under a unit key is a range or a size"
        },
        "p": {
          "$ref": "#/$defs/provenance"
        },
        "src": {
          "type": "string",
          "description": "where the value came from or a short qualifier"
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}(-[0-9]{2})?$"
        }
      }
    },
    "node": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/$defs/leaf"
          },
          {
            "$ref": "#/$defs/node"
          }
        ]
      }
    },
    "num": {
      "allOf": [
        {
          "$ref": "#/$defs/leaf"
        },
        {
          "properties": {
            "v": {
              "type": "number"
            }
          }
        }
      ]
    },
    "range": {
      "allOf": [
        {
          "$ref": "#/$defs/leaf"
        },
        {
          "properties": {
            "v": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        }
      ]
    },
    "numOrRange": {
      "anyOf": [
        {
          "$ref": "#/$defs/num"
        },
        {
          "$ref": "#/$defs/range"
        }
      ]
    },
    "rgbValue": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      },
      "minItems": 3,
      "maxItems": 3
    },
    "rgb": {
      "allOf": [
        {
          "$ref": "#/$defs/leaf"
        },
        {
          "properties": {
            "v": {
              "$ref": "#/$defs/rgbValue"
            }
          }
        }
      ]
    },
    "text": {
      "allOf": [
        {
          "$ref": "#/$defs/leaf"
        },
        {
          "properties": {
            "v": {
              "type": "string"
            }
          }
        }
      ]
    },
    "textList": {
      "allOf": [
        {
          "$ref": "#/$defs/leaf"
        },
        {
          "properties": {
            "v": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      ]
    }
  }
}
