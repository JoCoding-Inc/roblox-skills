{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JoCoding-Inc/roblox-skills/design/schema/tokens.schema.json",
  "title": "Stud house style tokens: surface kit, color ramps, panels, text, currency gradients, house rules",
  "type": "object",
  "required": [
    "type",
    "schema_version",
    "title",
    "scope",
    "sources",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "tokens"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "title": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data": {
      "type": "object",
      "required": [
        "kit",
        "ramps",
        "color_meaning",
        "panel",
        "text",
        "currency_gradients",
        "rules"
      ],
      "properties": {
        "kit": {
          "type": "object",
          "required": [
            "button",
            "chip",
            "tile",
            "card",
            "band"
          ],
          "properties": {
            "button": {
              "$ref": "#/$defs/kitKind"
            },
            "chip": {
              "$ref": "#/$defs/kitKind"
            },
            "tile": {
              "$ref": "#/$defs/kitKind"
            },
            "card": {
              "$ref": "#/$defs/kitKind"
            },
            "band": {
              "$ref": "#/$defs/kitKind"
            }
          },
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "#/$defs/leaf"
              },
              {
                "$ref": "#/$defs/node"
              }
            ]
          }
        },
        "ramps": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": [
              "top_rgb",
              "bottom_rgb",
              "lip_rgb"
            ],
            "properties": {
              "top_rgb": {
                "$ref": "#/$defs/rgb"
              },
              "bottom_rgb": {
                "$ref": "#/$defs/rgb"
              },
              "lip_rgb": {
                "$ref": "#/$defs/rgb"
              }
            },
            "additionalProperties": false
          }
        },
        "currency_gradients": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": [
              "from_rgb",
              "to_rgb"
            ],
            "properties": {
              "from_rgb": {
                "$ref": "#/$defs/rgb"
              },
              "to_rgb": {
                "$ref": "#/$defs/rgb"
              }
            },
            "additionalProperties": false
          }
        },
        "color_meaning": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/text"
          }
        },
        "panel": {
          "$ref": "#/$defs/node"
        },
        "surface": {
          "$ref": "#/$defs/node"
        },
        "text": {
          "$ref": "#/$defs/node"
        },
        "stud_tiles": {
          "$ref": "#/$defs/node"
        },
        "rules": {
          "$ref": "#/$defs/node"
        }
      },
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/$defs/leaf"
          },
          {
            "$ref": "#/$defs/node"
          }
        ]
      }
    }
  },
  "$defs": {
    "provenance": {
      "enum": [
        "measured",
        "documented",
        "field",
        "opinion"
      ],
      "description": "measured: we measured it (engine source, pixels on reference frames, store API, tested in Studio); documented: Roblox docs or staff posts; field: observed while shipping a game (dated when known); opinion: judgment, house style, owner rule or community starting value"
    },
    "leaf": {
      "type": "object",
      "required": [
        "v",
        "p"
      ],
      "additionalProperties": false,
      "properties": {
        "v": {
          "description": "the value; units are in the key name (_px, _s, _share, _scale, _rgb, _studs, _deg); [a, b] under a unit key is a range or a size"
        },
        "p": {
          "$ref": "#/$defs/provenance"
        },
        "src": {
          "type": "string",
          "description": "where the value came from or a short qualifier"
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}(-[0-9]{2})?$"
        }
      }
    },
    "node": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/$defs/leaf"
          },
          {
            "$ref": "#/$defs/node"
          }
        ]
      }
    },
    "num": {
      "allOf": [
        {
          "$ref": "#/$defs/leaf"
        },
        {
          "properties": {
            "v": {
              "type": "number"
            }
          }
        }
      ]
    },
    "range": {
      "allOf": [
        {
          "$ref": "#/$defs/leaf"
        },
        {
          "properties": {
            "v": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        }
      ]
    },
    "numOrRange": {
      "anyOf": [
        {
          "$ref": "#/$defs/num"
        },
        {
          "$ref": "#/$defs/range"
        }
      ]
    },
    "rgbValue": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      },
      "minItems": 3,
      "maxItems": 3
    },
    "rgb": {
      "allOf": [
        {
          "$ref": "#/$defs/leaf"
        },
        {
          "properties": {
            "v": {
              "$ref": "#/$defs/rgbValue"
            }
          }
        }
      ]
    },
    "text": {
      "allOf": [
        {
          "$ref": "#/$defs/leaf"
        },
        {
          "properties": {
            "v": {
              "type": "string"
            }
          }
        }
      ]
    },
    "textList": {
      "allOf": [
        {
          "$ref": "#/$defs/leaf"
        },
        {
          "properties": {
            "v": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "kitKind": {
      "type": "object",
      "required": [
        "lip_of_height",
        "stroke_px"
      ],
      "properties": {
        "lip_of_height": {
          "$ref": "#/$defs/num"
        },
        "corner_scale": {
          "$ref": "#/$defs/num"
        },
        "corner_px": {
          "$ref": "#/$defs/num"
        },
        "stroke_px": {
          "$ref": "#/$defs/num"
        },
        "stud_rows": {
          "$ref": "#/$defs/num"
        },
        "stud_tile_px": {
          "$ref": "#/$defs/num"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/leaf"
      }
    }
  }
}
