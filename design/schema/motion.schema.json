{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JoCoding-Inc/roblox-skills/design/schema/motion.schema.json",
  "title": "UI motion: panel open and close, button feedback, counters, idle motion, rules",
  "description": "Derived from the motion data by scripts/export_design_pack.py --write-schemas: every key present today is required and typed. Unknown keys are allowed everywhere (minor versions add keys); readers ignore them.",
  "type": "object",
  "required": [
    "type",
    "schema_version",
    "title",
    "scope",
    "sources",
    "data"
  ],
  "properties": {
    "type": {
      "const": "motion"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "title": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data": {
      "type": "object",
      "required": [
        "panel_open",
        "panel_close",
        "button",
        "number_count_up_s",
        "float",
        "idle_rotate_deg",
        "badge_attention",
        "stroke_scaling",
        "rules"
      ],
      "properties": {
        "panel_open": {
          "type": "object",
          "required": [
            "from_scale",
            "to_scale",
            "easing",
            "duration_s"
          ],
          "properties": {
            "from_scale": {
              "allOf": [
                {
                  "$ref": "#/$defs/leaf"
                },
                {
                  "properties": {
                    "v": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                }
              ]
            },
            "to_scale": {
              "allOf": [
                {
                  "$ref": "#/$defs/leaf"
                },
                {
                  "properties": {
                    "v": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                }
              ]
            },
            "easing": {
              "allOf": [
                {
                  "$ref": "#/$defs/leaf"
                },
                {
                  "properties": {
                    "v": {
                      "type": "string"
                    }
                  }
                }
              ]
            },
            "duration_s": {
              "allOf": [
                {
                  "$ref": "#/$defs/leaf"
                },
                {
                  "properties": {
                    "v": {
                      "type": "array",
                      "items": {
                        "type": "number",
                        "minimum": 0
                      },
                      "minItems": 2,
                      "maxItems": 2
                    }
                  }
                }
              ]
            }
          },
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "#/$defs/leaf"
              },
              {
                "$ref": "#/$defs/node"
              }
            ]
          }
        },
        "panel_close": {
          "type": "object",
          "required": [
            "duration_s"
          ],
          "properties": {
            "duration_s": {
              "allOf": [
                {
                  "$ref": "#/$defs/leaf"
                },
                {
                  "properties": {
                    "v": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                }
              ]
            }
          },
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "#/$defs/leaf"
              },
              {
                "$ref": "#/$defs/node"
              }
            ]
          }
        },
        "button": {
          "type": "object",
          "required": [
            "hover_scale",
            "press_scale",
            "duration_s",
            "via"
          ],
          "properties": {
            "hover_scale": {
              "allOf": [
                {
                  "$ref": "#/$defs/leaf"
                },
                {
                  "properties": {
                    "v": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                }
              ]
            },
            "press_scale": {
              "allOf": [
                {
                  "$ref": "#/$defs/leaf"
                },
                {
                  "properties": {
                    "v": {
                      "type": "array",
                      "items": {
                        "type": "number",
                        "minimum": 0
                      },
                      "minItems": 2,
                      "maxItems": 2
                    }
                  }
                }
              ]
            },
            "duration_s": {
              "allOf": [
                {
                  "$ref": "#/$defs/leaf"
                },
                {
                  "properties": {
                    "v": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                }
              ]
            },
            "via": {
              "allOf": [
                {
                  "$ref": "#/$defs/leaf"
                },
                {
                  "properties": {
                    "v": {
                      "type": "string"
                    }
                  }
                }
              ]
            }
          },
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "#/$defs/leaf"
              },
              {
                "$ref": "#/$defs/node"
              }
            ]
          }
        },
        "number_count_up_s": {
          "allOf": [
            {
              "$ref": "#/$defs/leaf"
            },
            {
              "properties": {
                "v": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          ]
        },
        "float": {
          "type": "object",
          "required": [
            "distance_px_min",
            "period_s"
          ],
          "properties": {
            "distance_px_min": {
              "allOf": [
                {
                  "$ref": "#/$defs/leaf"
                },
                {
                  "properties": {
                    "v": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                }
              ]
            },
            "period_s": {
              "allOf": [
                {
                  "$ref": "#/$defs/leaf"
                },
                {
                  "properties": {
                    "v": {
                      "type": "array",
                      "items": {
                        "type": "number",
                        "minimum": 0
                      },
                      "minItems": 2,
                      "maxItems": 2
                    }
                  }
                }
              ]
            }
          },
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "#/$defs/leaf"
              },
              {
                "$ref": "#/$defs/node"
              }
            ]
          }
        },
        "idle_rotate_deg": {
          "allOf": [
            {
              "$ref": "#/$defs/leaf"
            },
            {
              "properties": {
                "v": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          ]
        },
        "badge_attention": {
          "allOf": [
            {
              "$ref": "#/$defs/leaf"
            },
            {
              "properties": {
                "v": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "stroke_scaling": {
          "allOf": [
            {
              "$ref": "#/$defs/leaf"
            },
            {
              "properties": {
                "v": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "rules": {
          "type": "object",
          "required": [
            "animate_uiscale_not_size",
            "never_scale_text_continuously",
            "never_tween_stroke_thickness_or_text_size",
            "honor_reduced_motion"
          ],
          "properties": {
            "animate_uiscale_not_size": {
              "allOf": [
                {
                  "$ref": "#/$defs/leaf"
                },
                {
                  "properties": {
                    "v": {
                      "type": "boolean"
                    }
                  }
                }
              ]
            },
            "never_scale_text_continuously": {
              "allOf": [
                {
                  "$ref": "#/$defs/leaf"
                },
                {
                  "properties": {
                    "v": {
                      "type": "boolean"
                    }
                  }
                }
              ]
            },
            "never_tween_stroke_thickness_or_text_size": {
              "allOf": [
                {
                  "$ref": "#/$defs/leaf"
                },
                {
                  "properties": {
                    "v": {
                      "type": "boolean"
                    }
                  }
                }
              ]
            },
            "honor_reduced_motion": {
              "allOf": [
                {
                  "$ref": "#/$defs/leaf"
                },
                {
                  "properties": {
                    "v": {
                      "type": "string"
                    }
                  }
                }
              ]
            }
          },
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "#/$defs/leaf"
              },
              {
                "$ref": "#/$defs/node"
              }
            ]
          }
        }
      },
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/$defs/leaf"
          },
          {
            "$ref": "#/$defs/node"
          }
        ]
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "provenance": {
      "enum": [
        "documented",
        "field",
        "measured",
        "opinion"
      ],
      "description": "documented: Roblox docs, staff posts or filings; field: observed while shipping a game (dated when known); measured: we measured it: engine source, pixels on reference frames, store API reads, tested in Studio; opinion: judgment, house style, owner rule or a community starting value"
    },
    "leaf": {
      "type": "object",
      "required": [
        "v",
        "p"
      ],
      "properties": {
        "v": {
          "description": "the value; units are in the key name (_px, _s, _share, _scale, _rgb, _studs, _deg); [a, b] under a unit key is a range or a width-height size"
        },
        "p": {
          "$ref": "#/$defs/provenance"
        },
        "src": {
          "type": "string",
          "description": "source or qualifier (for example 'about')"
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"
        }
      },
      "additionalProperties": true
    },
    "node": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/$defs/leaf"
          },
          {
            "$ref": "#/$defs/node"
          }
        ]
      }
    },
    "rgb": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      },
      "minItems": 3,
      "maxItems": 3
    }
  }
}
