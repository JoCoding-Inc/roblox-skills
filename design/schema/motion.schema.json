{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JoCoding-Inc/roblox-skills/design/schema/motion.schema.json",
  "title": "UI motion: panel open and close, button feedback, counters, idle motion, rules",
  "type": "object",
  "required": [
    "type",
    "schema_version",
    "title",
    "scope",
    "sources",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "motion"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "title": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data": {
      "type": "object",
      "required": [
        "panel_open",
        "panel_close",
        "button",
        "rules"
      ],
      "properties": {
        "panel_open": {
          "type": "object",
          "required": [
            "from_scale",
            "to_scale",
            "easing",
            "duration_s"
          ],
          "properties": {
            "from_scale": {
              "$ref": "#/$defs/num"
            },
            "to_scale": {
              "$ref": "#/$defs/num"
            },
            "easing": {
              "$ref": "#/$defs/text"
            },
            "duration_s": {
              "$ref": "#/$defs/numOrRange"
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/leaf"
          }
        },
        "panel_close": {
          "type": "object",
          "required": [
            "duration_s"
          ],
          "properties": {
            "duration_s": {
              "$ref": "#/$defs/numOrRange"
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/leaf"
          }
        },
        "button": {
          "type": "object",
          "required": [
            "hover_scale",
            "press_scale",
            "duration_s"
          ],
          "properties": {
            "hover_scale": {
              "$ref": "#/$defs/num"
            },
            "press_scale": {
              "$ref": "#/$defs/numOrRange"
            },
            "duration_s": {
              "$ref": "#/$defs/numOrRange"
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/leaf"
          }
        },
        "rules": {
          "$ref": "#/$defs/node"
        }
      },
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/$defs/leaf"
          },
          {
            "$ref": "#/$defs/node"
          }
        ]
      }
    }
  },
  "$defs": {
    "provenance": {
      "enum": [
        "measured",
        "documented",
        "field",
        "opinion"
      ],
      "description": "measured: we measured it (engine source, pixels on reference frames, store API, tested in Studio); documented: Roblox docs or staff posts; field: observed while shipping a game (dated when known); opinion: judgment, house style, owner rule or community starting value"
    },
    "leaf": {
      "type": "object",
      "required": [
        "v",
        "p"
      ],
      "additionalProperties": false,
      "properties": {
        "v": {
          "description": "the value; units are in the key name (_px, _s, _share, _scale, _rgb, _studs, _deg); [a, b] under a unit key is a range or a size"
        },
        "p": {
          "$ref": "#/$defs/provenance"
        },
        "src": {
          "type": "string",
          "description": "where the value came from or a short qualifier"
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}(-[0-9]{2})?$"
        }
      }
    },
    "node": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/$defs/leaf"
          },
          {
            "$ref": "#/$defs/node"
          }
        ]
      }
    },
    "num": {
      "allOf": [
        {
          "$ref": "#/$defs/leaf"
        },
        {
          "properties": {
            "v": {
              "type": "number"
            }
          }
        }
      ]
    },
    "range": {
      "allOf": [
        {
          "$ref": "#/$defs/leaf"
        },
        {
          "properties": {
            "v": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        }
      ]
    },
    "numOrRange": {
      "anyOf": [
        {
          "$ref": "#/$defs/num"
        },
        {
          "$ref": "#/$defs/range"
        }
      ]
    },
    "rgbValue": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      },
      "minItems": 3,
      "maxItems": 3
    },
    "rgb": {
      "allOf": [
        {
          "$ref": "#/$defs/leaf"
        },
        {
          "properties": {
            "v": {
              "$ref": "#/$defs/rgbValue"
            }
          }
        }
      ]
    },
    "text": {
      "allOf": [
        {
          "$ref": "#/$defs/leaf"
        },
        {
          "properties": {
            "v": {
              "type": "string"
            }
          }
        }
      ]
    },
    "textList": {
      "allOf": [
        {
          "$ref": "#/$defs/leaf"
        },
        {
          "properties": {
            "v": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      ]
    }
  }
}
