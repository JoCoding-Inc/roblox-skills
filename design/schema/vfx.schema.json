{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JoCoding-Inc/roblox-skills/design/schema/vfx.schema.json",
  "title": "Effects: rarity tier ladder, aura and particle limits, VFX house rules",
  "description": "Derived from the vfx data by scripts/export_design_pack.py --write-schemas: every key present today is required and typed. Unknown keys are allowed everywhere (minor versions add keys); readers ignore them.",
  "type": "object",
  "required": [
    "type",
    "schema_version",
    "title",
    "scope",
    "sources",
    "data"
  ],
  "properties": {
    "type": {
      "const": "vfx"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "title": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data": {
      "type": "object",
      "required": [
        "tiers",
        "tier_settings",
        "aura",
        "particles",
        "camera",
        "budgets",
        "rules"
      ],
      "properties": {
        "tiers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "rank",
              "name",
              "example_odds",
              "look",
              "effect",
              "seen_by"
            ],
            "properties": {
              "rank": {
                "allOf": [
                  {
                    "$ref": "#/$defs/leaf"
                  },
                  {
                    "properties": {
                      "v": {
                        "type": "number"
                      }
                    }
                  }
                ]
              },
              "name": {
                "allOf": [
                  {
                    "$ref": "#/$defs/leaf"
                  },
                  {
                    "properties": {
                      "v": {
                        "type": "string"
                      }
                    }
                  }
                ]
              },
              "example_odds": {
                "allOf": [
                  {
                    "$ref": "#/$defs/leaf"
                  },
                  {
                    "properties": {
                      "v": {
                        "type": "string"
                      }
                    }
                  }
                ]
              },
              "look": {
                "allOf": [
                  {
                    "$ref": "#/$defs/leaf"
                  },
                  {
                    "properties": {
                      "v": {
                        "type": "string"
                      }
                    }
                  }
                ]
              },
              "effect": {
                "allOf": [
                  {
                    "$ref": "#/$defs/leaf"
                  },
                  {
                    "properties": {
                      "v": {
                        "type": "string"
                      }
                    }
                  }
                ]
              },
              "reveal_s": {
                "allOf": [
                  {
                    "$ref": "#/$defs/leaf"
                  },
                  {
                    "properties": {
                      "v": {
                        "type": "array",
                        "items": {
                          "type": "number",
                          "minimum": 0
                        },
                        "minItems": 2,
                        "maxItems": 2
                      }
                    }
                  }
                ]
              },
              "seen_by": {
                "allOf": [
                  {
                    "$ref": "#/$defs/leaf"
                  },
                  {
                    "properties": {
                      "v": {
                        "type": "string"
                      }
                    }
                  }
                ]
              },
              "reveal_max_s": {
                "allOf": [
                  {
                    "$ref": "#/$defs/leaf"
                  },
                  {
                    "properties": {
                      "v": {
                        "type": "number",
                        "minimum": 0
                      }
                    }
                  }
                ]
              }
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "$ref": "#/$defs/leaf"
                },
                {
                  "$ref": "#/$defs/node"
                }
              ]
            }
          }
        },
        "tier_settings": {
          "type": "object",
          "required": [
            "skip_reveal_below_tier_default",
            "hide_announcements_below_tier"
          ],
          "properties": {
            "skip_reveal_below_tier_default": {
              "allOf": [
                {
                  "$ref": "#/$defs/leaf"
                },
                {
                  "properties": {
                    "v": {
                      "type": "number"
                    }
                  }
                }
              ]
            },
            "hide_announcements_below_tier": {
              "allOf": [
                {
                  "$ref": "#/$defs/leaf"
                },
                {
                  "properties": {
                    "v": {
                      "type": "boolean"
                    }
                  }
                }
              ]
            }
          },
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "#/$defs/leaf"
              },
              {
                "$ref": "#/$defs/node"
              }
            ]
          }
        },
        "aura": {
          "type": "object",
          "required": [
            "max_emitters_per_player",
            "max_trails_per_player",
            "live_particles_per_emitter",
            "highlights",
            "lights_from_tier",
            "distance_lod",
            "test_players"
          ],
          "properties": {
            "max_emitters_per_player": {
              "allOf": [
                {
                  "$ref": "#/$defs/leaf"
                },
                {
                  "properties": {
                    "v": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                }
              ]
            },
            "max_trails_per_player": {
              "allOf": [
                {
                  "$ref": "#/$defs/leaf"
                },
                {
                  "properties": {
                    "v": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                }
              ]
            },
            "live_particles_per_emitter": {
              "allOf": [
                {
                  "$ref": "#/$defs/leaf"
                },
                {
                  "properties": {
                    "v": {
                      "type": "number"
                    }
                  }
                }
              ]
            },
            "highlights": {
              "allOf": [
                {
                  "$ref": "#/$defs/leaf"
                },
                {
                  "properties": {
                    "v": {
                      "type": "boolean"
                    }
                  }
                }
              ]
            },
            "lights_from_tier": {
              "allOf": [
                {
                  "$ref": "#/$defs/leaf"
                },
                {
                  "properties": {
                    "v": {
                      "type": "number"
                    }
                  }
                }
              ]
            },
            "distance_lod": {
              "allOf": [
                {
                  "$ref": "#/$defs/leaf"
                },
                {
                  "properties": {
                    "v": {
                      "type": "string"
                    }
                  }
                }
              ]
            },
            "test_players": {
              "allOf": [
                {
                  "$ref": "#/$defs/leaf"
                },
                {
                  "properties": {
                    "v": {
                      "type": "number"
                    }
                  }
                }
              ]
            }
          },
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "#/$defs/leaf"
              },
              {
                "$ref": "#/$defs/node"
              }
            ]
          }
        },
        "particles": {
          "type": "object",
          "required": [
            "per_emitter_per_s_max",
            "per_emitter_per_s_mobile_max",
            "readable_size_studs_at_40_100",
            "additive_layer",
            "flipbook_layouts",
            "flipbooks_drop_on_low_memory",
            "time_scale_range"
          ],
          "properties": {
            "per_emitter_per_s_max": {
              "allOf": [
                {
                  "$ref": "#/$defs/leaf"
                },
                {
                  "properties": {
                    "v": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                }
              ]
            },
            "per_emitter_per_s_mobile_max": {
              "allOf": [
                {
                  "$ref": "#/$defs/leaf"
                },
                {
                  "properties": {
                    "v": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                }
              ]
            },
            "readable_size_studs_at_40_100": {
              "allOf": [
                {
                  "$ref": "#/$defs/leaf"
                },
                {
                  "properties": {
                    "v": {
                      "type": "array",
                      "items": {
                        "type": "number",
                        "minimum": 0
                      },
                      "minItems": 2,
                      "maxItems": 2
                    }
                  }
                }
              ]
            },
            "additive_layer": {
              "allOf": [
                {
                  "$ref": "#/$defs/leaf"
                },
                {
                  "properties": {
                    "v": {
                      "type": "object",
                      "required": [
                        "LightEmission",
                        "LightInfluence"
                      ],
                      "properties": {
                        "LightEmission": {
                          "type": "number"
                        },
                        "LightInfluence": {
                          "type": "number"
                        }
                      }
                    }
                  }
                }
              ]
            },
            "flipbook_layouts": {
              "allOf": [
                {
                  "$ref": "#/$defs/leaf"
                },
                {
                  "properties": {
                    "v": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              ]
            },
            "flipbooks_drop_on_low_memory": {
              "allOf": [
                {
                  "$ref": "#/$defs/leaf"
                },
                {
                  "properties": {
                    "v": {
                      "type": "boolean"
                    }
                  }
                }
              ]
            },
            "time_scale_range": {
              "allOf": [
                {
                  "$ref": "#/$defs/leaf"
                },
                {
                  "properties": {
                    "v": {
                      "type": "array",
                      "items": {
                        "type": "number",
                        "minimum": 0
                      },
                      "minItems": 2,
                      "maxItems": 2
                    }
                  }
                }
              ]
            }
          },
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "#/$defs/leaf"
              },
              {
                "$ref": "#/$defs/node"
              }
            ]
          }
        },
        "camera": {
          "type": "object",
          "required": [
            "shake_combine",
            "shake_sources",
            "off_switch"
          ],
          "properties": {
            "shake_combine": {
              "allOf": [
                {
                  "$ref": "#/$defs/leaf"
                },
                {
                  "properties": {
                    "v": {
                      "type": "string"
                    }
                  }
                }
              ]
            },
            "shake_sources": {
              "allOf": [
                {
                  "$ref": "#/$defs/leaf"
                },
                {
                  "properties": {
                    "v": {
                      "type": "string"
                    }
                  }
                }
              ]
            },
            "off_switch": {
              "allOf": [
                {
                  "$ref": "#/$defs/leaf"
                },
                {
                  "properties": {
                    "v": {
                      "type": "boolean"
                    }
                  }
                }
              ]
            }
          },
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "#/$defs/leaf"
              },
              {
                "$ref": "#/$defs/node"
              }
            ]
          }
        },
        "budgets": {
          "type": "object",
          "required": [
            "first_release_unique_sounds_max",
            "feedback_channels_per_frequent_action"
          ],
          "properties": {
            "first_release_unique_sounds_max": {
              "allOf": [
                {
                  "$ref": "#/$defs/leaf"
                },
                {
                  "properties": {
                    "v": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                }
              ]
            },
            "feedback_channels_per_frequent_action": {
              "allOf": [
                {
                  "$ref": "#/$defs/leaf"
                },
                {
                  "properties": {
                    "v": {
                      "type": "number"
                    }
                  }
                }
              ]
            }
          },
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "#/$defs/leaf"
              },
              {
                "$ref": "#/$defs/node"
              }
            ]
          }
        },
        "rules": {
          "type": "object",
          "required": [
            "vfx_source",
            "burst_not_constant",
            "night_sky"
          ],
          "properties": {
            "vfx_source": {
              "allOf": [
                {
                  "$ref": "#/$defs/leaf"
                },
                {
                  "properties": {
                    "v": {
                      "type": "string"
                    }
                  }
                }
              ]
            },
            "burst_not_constant": {
              "allOf": [
                {
                  "$ref": "#/$defs/leaf"
                },
                {
                  "properties": {
                    "v": {
                      "type": "string"
                    }
                  }
                }
              ]
            },
            "night_sky": {
              "allOf": [
                {
                  "$ref": "#/$defs/leaf"
                },
                {
                  "properties": {
                    "v": {
                      "type": "string"
                    }
                  }
                }
              ]
            }
          },
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "#/$defs/leaf"
              },
              {
                "$ref": "#/$defs/node"
              }
            ]
          }
        }
      },
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/$defs/leaf"
          },
          {
            "$ref": "#/$defs/node"
          }
        ]
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "provenance": {
      "enum": [
        "documented",
        "field",
        "measured",
        "opinion"
      ],
      "description": "documented: Roblox docs, staff posts or filings; field: observed while shipping a game (dated when known); measured: we measured it: engine source, pixels on reference frames, store API reads, tested in Studio; opinion: judgment, house style, owner rule or a community starting value"
    },
    "leaf": {
      "type": "object",
      "required": [
        "v",
        "p"
      ],
      "properties": {
        "v": {
          "description": "the value; units are in the key name (_px, _s, _share, _scale, _rgb, _studs, _deg); [a, b] under a unit key is a range or a width-height size"
        },
        "p": {
          "$ref": "#/$defs/provenance"
        },
        "src": {
          "type": "string",
          "description": "source or qualifier (for example 'about')"
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"
        }
      },
      "additionalProperties": true
    },
    "node": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/$defs/leaf"
          },
          {
            "$ref": "#/$defs/node"
          }
        ]
      }
    },
    "rgb": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      },
      "minItems": 3,
      "maxItems": 3
    }
  }
}
