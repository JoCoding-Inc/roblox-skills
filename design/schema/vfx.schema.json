      "items": {
        "type": "string"
      }
    },
    "data": {
      "type": "object",
      "required": [
        "tiers",
        "tier_settings",
        "aura",
        "particles",
        "camera",
        "budgets",
        "feedback",
        "reveal_timing_top_games",
        "rules"
